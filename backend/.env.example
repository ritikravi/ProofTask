# xAI Grok API — server-side only, never expose to clients
XAI_API_KEY=xai-your-key-here
# Model name — check console.x.ai for current available models
XAI_MODEL=grok-2-vision-1212

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/prooftask

# JWT secret for token signing (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret

# Server port
PORT=5000

# Flutter app origin for CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:8080

# GitHub personal access token for commit verification (optional)
# Only needed for private repos or to avoid GitHub API rate limits
GITHUB_TOKEN=
